# ═══════════════════════════════════════════════════════════════════════
# TÂN BẢO AGTECH | PLANT BOOK ERP v1.3.5
# FILE MẪU BIẾN MÔI TRƯỜNG CHO MÁY CHỦ NAS CÔNG TY
# Hướng dẫn: Copy file này thành .env.nas rồi điền mật khẩu bảo mật riêng của công ty
# Lệnh copy: cp .env.nas.example .env.nas
# ═══════════════════════════════════════════════════════════════════════

# 1. Cổng dịch vụ (Ports)
WEB_PORT=10000
POSTGRES_PORT=5432
REDIS_PORT=6379
PGADMIN_PORT=5050

# 2. Cấu hình CSDL PostgreSQL trên NAS
POSTGRES_DB=plant_book
POSTGRES_USER=plantbook
# Đặt mật khẩu mạnh (ít nhất 16 ký tự bao gồm chữ hoa, số và ký tự đặc biệt)
POSTGRES_PASSWORD=Tanbao_Secure_Db_Password_2026!

# 3. Cấu hình Redis Cache trên NAS
REDIS_PASSWORD=Tanbao_Secure_Redis_Pass_2026!

# 4. Cấu hình Ứng dụng Web
APP_URL=http://localhost:10000
# Đặt chuỗi bí mật JWT ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=plantbook_enterprise_nas_jwt_secret_key_change_me_now_2026
JWT_EXPIRES_IN=24h

# 5. Tài khoản Quản trị Admin ban đầu (được tạo tự động nếu chưa có)
ADMIN_EMAIL=admin@tanbaocorp.vn
ADMIN_PASSWORD=Tanbao@123

# 6. Quản trị CSDL trực quan qua trình duyệt (pgAdmin: http://<IP_NAS>:5050)
PGADMIN_EMAIL=admin@tanbaocorp.vn
PGADMIN_PASSWORD=Tanbao_Admin_PgPass_2026!

# 7. Lưu trữ ảnh cây trồng & chứng từ VietGAP
# 'local': Lưu trực tiếp vào ổ cứng NAS tại thư mục ./nas_storage/uploads
# 'r2' hoặc 's3' hoặc 'supabase': nếu muốn đẩy tiếp lên Cloud làm backup thứ cấp
STORAGE_DRIVER=local
STORAGE_PUBLIC_URL=

# 8. Tùy chọn đưa Web ra ngoài Internet qua Cloudflare Tunnel (Miễn phí, không cần mở port)
# Nếu dùng, lấy token tại https://one.dash.cloudflare.com và khởi chạy với cờ --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=
