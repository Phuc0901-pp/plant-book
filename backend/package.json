{
  "name": "plant-book-backend",
  "version": "1.2.0",
  "description": "Smart Plant Book - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node --dns-result-order=ipv4first server.js",
    "dev": "nodemon server.js",
    "migrate:up": "node db/migrate.js up",
    "migrate:status": "node db/migrate.js status",
    "build:html": "node scripts/build-html.js",
    "sync:config": "node ../scripts/sync-config.js",
    "bump:version": "node ../scripts/sync-config.js",
    "test": "node tests/run-all-tests.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.3",
    "uuid": "^9.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "nodemon": "^3.0.2"
  }
}
